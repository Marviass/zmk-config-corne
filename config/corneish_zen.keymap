#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/* Указываем ZMK использовать 5-колоночную матрицу (36 клавиш) */
/ {
    chosen {
        zmk,physical-layout = &foostan_corne_5col_layout;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Базовый QWERTY слой
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T         &kp Y &kp U &kp I &kp O &kp P
                &kp A &kp S &kp D &kp F &kp G         &kp H &kp J &kp K &kp L &kp SEMI
                &kp Z &kp X &kp C &kp V &kp B         &kp N &kp M &kp COMMA &kp DOT &kp FSLH
                        &kp LGUI &mo 1 &kp SPACE      &kp RET &mo 2 &kp BSPC
            >;
        };

        lower_layer {
            // Цифры и навигация (включается левым большим пальцем)
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5    &kp N6 &kp N7 &kp N8 &kp N9 &kp N0
                &kp TAB &trans &trans &trans &trans   &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp DEL
                &kp LSHFT &trans &trans &trans &trans &trans &trans &trans &trans &trans
                        &trans &trans &trans          &trans &trans &trans
            >;
        };

        raise_layer {
            // Символы и Bluetooth (включается правым большим пальцем)
            bindings = <
                &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT      &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3   &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH
                &kp LSHFT &trans &trans &trans &trans            &kp UNDER &kp PLUS &kp LBRC &kp RBRC &kp PIPE
                                 &trans &trans &trans            &trans &trans &trans
            >;
        };
    };
};
